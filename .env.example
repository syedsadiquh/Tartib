# Copy to .env and fill in. See docs/plans/01-architecture.md §5.
APP_ENV=dev
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
API_HOST=localhost
# Web only (Vercel env): target of the Next.js /api rewrite. Unset in dev → localhost:8000
API_ORIGIN=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# python -c "import secrets;print(secrets.token_hex(32))"
APP_SESSION_SECRET=
DATABASE_URL=postgresql+psycopg://tartib:tartib@localhost:5433/tartib
TEST_DATABASE_URL=postgresql+psycopg://tartib:tartib@localhost:5433/tartib_test
OWNER_EMAIL=
POSTGRES_PASSWORD=tartib

# Optional - may instead be entered in Settings (stored encrypted, D-18)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tartib@localhost
DISCORD_ALERT_WEBHOOK_URL=
HEALTHCHECK_PING_URL=

# 1 = in-memory Google Calendar (dev/test, no Google account needed)
FAKE_GOOGLE=1
